<?xml version="1.0"?>
<!--
  12-DOF 四足机器狗通用模型
  构型: 4 腿 x 3 关节 = 12 自由度
    - {leg}_hip_joint   : 侧摆髋 (abduction/adduction, 绕 X 轴)
    - {leg}_thigh_joint : 前摆髋 (hip flexion, 绕 Y 轴)
    - {leg}_calf_joint  : 膝关节 (knee, 绕 Y 轴)
  零位: 四条腿竖直向下
  腿部命名: FL=左前 FR=右前 RL=左后 RR=右后 (与 Unitree 系一致)
-->
<robot name="quadruped_12dof" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ 机体参数 ============ -->
  <xacro:property name="trunk_length" value="0.40"/>
  <xacro:property name="trunk_width"  value="0.16"/>
  <xacro:property name="trunk_height" value="0.10"/>
  <xacro:property name="trunk_mass"   value="6.0"/>

  <!-- 髋关节在躯干上的安装位置 -->
  <xacro:property name="hip_offset_x" value="0.19"/>   <!-- 前/后方向 -->
  <xacro:property name="hip_offset_y" value="0.075"/>  <!-- 左/右方向 -->
  <xacro:property name="hip_offset_z" value="-0.03"/>

  <!-- 腿段参数 -->
  <xacro:property name="hip_lateral_offset" value="0.055"/> <!-- 侧摆髋到大腿关节的横向距离 -->
  <xacro:property name="thigh_length" value="0.25"/>
  <xacro:property name="calf_length"  value="0.25"/>
  <xacro:property name="thigh_mass"   value="0.6"/>
  <xacro:property name="calf_mass"    value="0.25"/>
  <xacro:property name="hip_mass"     value="0.3"/>

  <!-- ============ 材质 ============ -->
  <material name="dark_gray"><color rgba="0.25 0.25 0.28 1.0"/></material>
  <material name="light_gray"><color rgba="0.6 0.6 0.62 1.0"/></material>
  <material name="orange"><color rgba="0.9 0.4 0.1 1.0"/></material>

  <!-- ============ 躯干 ============ -->
  <link name="base_link">
    <inertial>
      <mass value="${trunk_mass}"/>
      <origin xyz="0 0 0"/>
      <!-- 长方体惯性: Ixx=m/12(w^2+h^2) 等 -->
      <inertia ixx="0.0178" ixy="0.0" ixz="0.0"
               iyy="0.0850" iyz="0.0"
               izz="0.0928"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="${trunk_length} ${trunk_width} ${trunk_height}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="${trunk_length} ${trunk_width} ${trunk_height}"/></geometry>
    </collision>
  </link>

  <!-- ============ 单腿宏 ============ -->
  <!-- prefix: FL/FR/RL/RR;  x_sign: 前+1/后-1;  y_sign: 左+1/右-1 -->
  <xacro:macro name="quadruped_leg" params="prefix x_sign y_sign">

    <!-- 侧摆髋关节电机 (hip link) -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${x_sign*hip_offset_x} ${y_sign*hip_offset_y} ${hip_offset_z}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.7" upper="0.7" effort="20.0" velocity="20.0"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>
    <link name="${prefix}_hip_link">
      <inertial>
        <mass value="${hip_mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.00016" ixy="0.0" ixz="0.0"
                 iyy="0.00016" iyz="0.0"
                 izz="0.000135"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="0.035" length="0.06"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="0.035" length="0.06"/></geometry>
      </collision>
    </link>

    <!-- 前摆髋关节 (thigh link 起点) -->
    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 ${y_sign*hip_lateral_offset} 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.8" upper="1.8" effort="25.0" velocity="20.0"/>
      <dynamics damping="0.2" friction="0.05"/>
    </joint>
    <link name="${prefix}_thigh_link">
      <inertial>
        <mass value="${thigh_mass}"/>
        <origin xyz="0 0 ${-thigh_length/2}"/>
        <inertia ixx="0.0032" ixy="0.0" ixz="0.0"
                 iyy="0.0032" iyz="0.0"
                 izz="0.00012"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-thigh_length/2}"/>
        <geometry><cylinder radius="0.02" length="${thigh_length}"/></geometry>
        <material name="light_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-thigh_length/2}"/>
        <geometry><cylinder radius="0.02" length="${thigh_length}"/></geometry>
      </collision>
    </link>

    <!-- 膝关节 (calf link 起点) -->
    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <origin xyz="0 0 ${-thigh_length}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="2.9" effort="25.0" velocity="20.0"/>
      <dynamics damping="0.1" friction="0.02"/>
    </joint>
    <link name="${prefix}_calf_link">
      <inertial>
        <mass value="${calf_mass}"/>
        <origin xyz="0 0 ${-calf_length/2}"/>
        <inertia ixx="0.0013" ixy="0.0" ixz="0.0"
                 iyy="0.0013" iyz="0.0"
                 izz="0.000018"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-calf_length/2}"/>
        <geometry><cylinder radius="0.012" length="${calf_length}"/></geometry>
        <material name="light_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-calf_length/2}"/>
        <geometry><cylinder radius="0.012" length="${calf_length}"/></geometry>
      </collision>
      <!-- 足端球 -->
      <visual>
        <origin xyz="0 0 ${-calf_length}"/>
        <geometry><sphere radius="0.02"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-calf_length}"/>
        <geometry><sphere radius="0.02"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ============ 装配四条腿 ============ -->
  <xacro:quadruped_leg prefix="FL" x_sign="1"  y_sign="1"/>
  <xacro:quadruped_leg prefix="FR" x_sign="1"  y_sign="-1"/>
  <xacro:quadruped_leg prefix="RL" x_sign="-1" y_sign="1"/>
  <xacro:quadruped_leg prefix="RR" x_sign="-1" y_sign="-1"/>

</robot>
